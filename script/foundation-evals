enum CLIError: LocalizedError {
    case usage(String)
    case transport(String)
    case protocolFailure(String)
    case targetNotFound(String)

    var errorDescription: String? {
        switch self {
        case .usage(let message), .transport(let message), .protocolFailure(let message), .targetNotFound(let message):
            message
        }
    }
}

struct Options {
    var project: String
    var suite: String
    var runID = UUID()
    var timeout = 1_800.0
    var endpoint = URL(string: "http://127.0.0.1:17873/mcp")!
    var credentialFile: URL?

    init(arguments: [String]) throws {
        if arguments == ["--help"] || arguments == ["-h"] {
            print(Self.help)
            exit(0)
        }
        guard arguments.first == "check" else {
            throw CLIError.usage(Self.help)
        }
        var values: [String: String] = [:]
        var index = 1
        while index < arguments.count {
            let option = arguments[index]
            guard option.hasPrefix("--"), index + 1 < arguments.count else {
                throw CLIError.usage("Invalid argument '\(option)'.\n\n\(Self.help)")
            }
            guard values[option] == nil else {
                throw CLIError.usage("Option '\(option)' was provided more than once.\n\n\(Self.help)")
            }
            values[option] = arguments[index + 1]
            index += 2
        }
        guard let project = values["--project"], let suite = values["--suite"] else {
            throw CLIError.usage(Self.help)
        }
        self.project = project
        self.suite = suite
        if let value = values["--run-id"] {
            guard let id = UUID(uuidString: value) else { throw CLIError.usage("--run-id must be a UUID.") }
            runID = id
        }
        if let value = values["--timeout"] {
            guard let seconds = Double(value), seconds > 0 else {
                throw CLIError.usage("--timeout must be a positive number of seconds.")
            }
            timeout = seconds
        }
        if let value = values["--endpoint"] {
            guard let url = URL(string: value),
                  let scheme = url.scheme?.lowercased(),
                  ["http", "https"].contains(scheme),
                  url.host != nil else {
                throw CLIError.usage("--endpoint must be an absolute HTTP or HTTPS URL.")
            }
            endpoint = url
        }
        credentialFile = values["--credential-file"].map { URL(fileURLWithPath: $0) }
        let known = Set(["--project", "--suite", "--run-id", "--timeout", "--endpoint", "--credential-file"])
        if let unknown = values.keys.first(where: { !known.contains($0) }) {
            throw CLIError.usage("Unknown option '\(unknown)'.\n\n\(Self.help)")
        }
    }

    static let help = """
    Usage:
      foundation-evals check --project <id|name|repository-path> --suite <id|name> [options]
      foundation-evals scenario-report --run-id <uuid> [--endpoint <url>]
      foundation-evals scenario-execution-report --execution-id <uuid> [--endpoint <url>]

    check options:
      --project <id|name|repository-path>
      --suite <id|name>
      --run-id <uuid>       Reuse a stable run ID after an uncertain response.
      --timeout <seconds>   Overall wait limit (default: 1800).

    scenario-execution-report options:
      --execution-id <uuid> Saved stable execution record to qualify (read-only).
      Returns 0 for qualified evidence, 10 for required failures, 20 for incomplete evidence.

    scenario-report options:
      --run-id <uuid>       Saved Intent Lab scenario run to report.
      --endpoint <url>      Running app MCP endpoint (default: http://127.0.0.1:17873/mcp).
      --credential-file <path>  Private UTF-8 bearer token file (all commands).

    The Intents macOS app must be running with its MCP connector started.
    The default endpoint uses its login Keychain credential; macOS may ask to allow access.
    Custom endpoints require --credential-file or FOUNDATION_EVALS_MCP_CREDENTIAL.
    Remote credentials require HTTPS. Redirects are not followed.
    """
}

struct ScenarioReportOptions {
    var runID: UUID
    var stableExecution = false
    var endpoint = URL(string: "http://127.0.0.1:17873/mcp")!
    var credentialFile: URL?

    init(arguments: [String]) throws {
        guard ["scenario-report", "scenario-execution-report"].contains(arguments.first ?? "") else {
            throw CLIError.usage(Options.help)
        }
        var values: [String: String] = [:]
        var index = 1
        while index < arguments.count {
            let option = arguments[index]
            guard option.hasPrefix("--"), index + 1 < arguments.count else {
                throw CLIError.usage("Invalid argument '\(option)'.\n\n\(Options.help)")
            }
            guard values[option] == nil else {
                throw CLIError.usage("Option '\(option)' was provided more than once.\n\n\(Options.help)")
            }
            values[option] = arguments[index + 1]
            index += 2
        }
        stableExecution = arguments.first == "scenario-execution-report"
        let idOption = stableExecution ? "--execution-id" : "--run-id"
        guard let value = values[idOption], let id = UUID(uuidString: value) else {
            throw CLIError.usage("\(arguments[0]) requires \(idOption) with a UUID.\n\n\(Options.help)")
        }
        runID = id
        if let value = values["--endpoint"] {
            guard let url = URL(string: value),
                  let scheme = url.scheme?.lowercased(),
                  ["http", "https"].contains(scheme),
                  url.host != nil else {
                throw CLIError.usage("--endpoint must be an absolute HTTP or HTTPS URL.")
            }
            endpoint = url
        }
        credentialFile = values["--credential-file"].map { URL(fileURLWithPath: $0) }
        let known = Set([idOption, "--endpoint", "--credential-file"])
        if let unknown = values.keys.first(where: { !known.contains($0) }) {
            throw CLIError.usage("Unknown option '\(unknown)'.\n\n\(Options.help)")
        }
    }
}

enum MCPCredential {
    static func isLiteralLoopback(_ host: String) -> Bool {
        if ["localhost", "::1", "[::1]"].contains(host) { return true }
        var address = in_addr()
        return host.withCString { inet_pton(AF_INET, $0, &address) } == 1
            && UInt32(bigEndian: address.s_addr) >> 24 == 127
    }

    static func readCredentialFile(_ file: URL) throws -> Data {
        let message = "The credential file must be owned by you, readable only by you, a regular file, and at most 4096 bytes."
        // Nonblocking open also prevents a substituted FIFO from hanging before
        // fstat rejects it. All validation and reads use this single descriptor.
        let descriptor = file.path.withCString { open($0, O_RDONLY | O_NOFOLLOW | O_CLOEXEC | O_NONBLOCK) }
        guard descriptor >= 0 else { throw CLIError.usage(message) }
        defer { close(descriptor) }
        var metadata = stat()
        guard fstat(descriptor, &metadata) == 0,
              metadata.st_mode & mode_t(S_IFMT) == mode_t(S_IFREG),
              metadata.st_uid == getuid(), metadata.st_mode & 0o077 == 0,
              metadata.st_size >= 0, metadata.st_size <= 4096 else {
            throw CLIError.usage(message)
        }
        var data = Data()
        var buffer = [UInt8](repeating: 0, count: 4097)
        while data.count <= 4096 {
            let count = buffer.withUnsafeMutableBytes { read(descriptor, $0.baseAddress!, 4097 - data.count) }
            if count < 0 {
                if errno == EINTR { continue }
                throw CLIError.usage(message)
            }
            if count == 0 { return data }
            data.append(contentsOf: buffer.prefix(count))
        }
        throw CLIError.usage(message)
    }

    static func load(for endpoint: URL, file: URL?) throws -> String {
        let host = endpoint.host?.lowercased() ?? ""
        let isLoopback = isLiteralLoopback(host)
        guard endpoint.user == nil, endpoint.password == nil, endpoint.fragment == nil,
              endpoint.scheme?.lowercased() == "https" || isLoopback else {
            throw CLIError.usage("Credentials require a loopback HTTP endpoint or an HTTPS endpoint without embedded credentials.")
        }
        let data: Data
        if let file {
            data = try readCredentialFile(file)
        } else if let supplied = ProcessInfo.processInfo.environment["FOUNDATION_EVALS_MCP_CREDENTIAL"], !supplied.isEmpty {
            data = Data(supplied.utf8)
        } else {
            guard endpoint == URL(string: "http://127.0.0.1:17873/mcp")! else {
                throw CLIError.usage("A custom endpoint requires --credential-file or FOUNDATION_EVALS_MCP_CREDENTIAL; the local connector credential is not sent to other endpoints.")
            }
            #if canImport(Security)
            let query: [String: Any] = [
                kSecClass as String: kSecClassGenericPassword,
                kSecAttrService as String: "com.coryparry.FoundationEvals.mcp.authorization.v1",
                kSecAttrAccount as String: "local-connector",
                kSecReturnData as String: true,
                kSecMatchLimit as String: kSecMatchLimitOne,
            ]
            var result: CFTypeRef?
            guard SecItemCopyMatching(query as CFDictionary, &result) == errSecSuccess,
                  let stored = result as? Data else {
                throw CLIError.usage("The MCP credential is unavailable. Allow Keychain access for this CLI, connect to Codex in Intents, or provide --credential-file.")
            }
            data = stored
            #else
            throw CLIError.usage("Provide --credential-file on platforms without the macOS Keychain.")
            #endif
        }
        guard data.count <= 4_096,
              let text = String(data: data, encoding: .utf8) else {
            throw CLIError.usage("The MCP credential must be a UTF-8 bearer token.")
        }
        let token = text.trimmingCharacters(in: .whitespacesAndNewlines)
        guard !token.isEmpty, token.utf8.allSatisfy({ (33...126).contains($0) }) else {
            throw CLIError.usage("The MCP credential must be a nonempty bearer token without whitespace.")
        }
        return token
    }
}

/// Authentication must never be forwarded to a redirected endpoint.
final class MCPRedirectPolicy: NSObject, URLSessionTaskDelegate {
    func urlSession(_ session: URLSession, task: URLSessionTask,
                    willPerformHTTPRedirection response: HTTPURLResponse,
                    newRequest request: URLRequest,
                    completionHandler: @escaping (URLRequest?) -> Void) {
        completionHandler(nil)
    }
}

final class MCPClient {
    private let endpoint: URL
    private let credential: String
    private let session = URLSession(configuration: .ephemeral, delegate: MCPRedirectPolicy(), delegateQueue: nil)
    private var nextID = 1

    init(endpoint: URL, credentialFile: URL?) throws {
        credential = try MCPCredential.load(for: endpoint, file: credentialFile)
        self.endpoint = endpoint
    }

    deinit { session.invalidateAndCancel() }

    func initialize() throws {
        _ = try request(method: "initialize", params: [
            "protocolVersion": "2025-06-18",
            "capabilities": [String: Any](),
            "clientInfo": ["name": "foundation-evals-cli", "version": "1"]
        ], includeVersion: false)
    }

    func call(tool: String, arguments: [String: Any]) throws -> [String: Any] {
        let response = try request(method: "tools/call", params: ["name": tool, "arguments": arguments])
        guard let result = response["result"] as? [String: Any],
              let content = result["structuredContent"] as? [String: Any] else {
            throw CLIError.protocolFailure("The app returned no structured result for \(tool).")
        }
        if result["isError"] as? Bool == true {
            let error = content["error"] as? [String: Any]
            throw CLIError.protocolFailure(error?["message"] as? String ?? "\(tool) failed.")
        }
        return content
    }

    private func request(method: String, params: [String: Any], includeVersion: Bool = true) throws -> [String: Any] {
        let id = nextID
        nextID += 1
        let body: [String: Any] = ["jsonrpc": "2.0", "id": id, "method": method, "params": params]
        let bodyData = try JSONSerialization.data(withJSONObject: body, options: [.sortedKeys])
        var request = URLRequest(url: endpoint)
        request.httpMethod = "POST"
        request.httpBody = bodyData
        request.setValue("application/json", forHTTPHeaderField: "Content-Type")
        request.setValue("application/json", forHTTPHeaderField: "Accept")
        request.setValue("Bearer \(credential)", forHTTPHeaderField: "Authorization")
        if includeVersion { request.setValue("2025-06-18", forHTTPHeaderField: "MCP-Protocol-Version") }

        let semaphore = DispatchSemaphore(value: 0)
        var output: Result<Data, Error>?
        session.dataTask(with: request) { data, response, error in
            if let error {
                output = .failure(error)
            } else if let http = response as? HTTPURLResponse, !(200...299).contains(http.statusCode) {
                output = .failure(CLIError.transport("The app connector returned HTTP \(http.statusCode)."))
            } else if let data {
                output = .success(data)
            } else {
                output = .failure(CLIError.transport("The app connector returned an empty response."))
            }
            semaphore.signal()
        }.resume()
        semaphore.wait()
        guard let output else { throw CLIError.transport("The app connector did not complete the request.") }
        let data = try output.get()
        guard let json = try JSONSerialization.jsonObject(with: data) as? [String: Any] else {
            throw CLIError.protocolFailure("The app connector returned invalid JSON.")
        }
        if let error = json["error"] as? [String: Any] {
            throw CLIError.protocolFailure(error["message"] as? String ?? "MCP request failed.")
        }
        return json
    }
}

func normalizedPath(_ value: String) -> String {
    URL(fileURLWithPath: value).standardizedFileURL.path
}

func resolveTargets(_ content: [String: Any], projectInput: String, suiteInput: String) throws -> (String, String) {
    guard let projects = content["projects"] as? [[String: Any]] else {
        throw CLIError.protocolFailure("The app returned no project catalog.")
    }
    let matchingProjects = projects.filter { item in
        (item["id"] as? String)?.caseInsensitiveCompare(projectInput) == .orderedSame
            || (item["name"] as? String)?.caseInsensitiveCompare(projectInput) == .orderedSame
            || (item["repositoryRoot"] as? String).map { normalizedPath($0) == normalizedPath(projectInput) } == true
    }
    guard !matchingProjects.isEmpty else {
        throw CLIError.targetNotFound("No project matches '\(projectInput)'. Run the app and check Projects and Suites.")
    }
    guard matchingProjects.count == 1,
          let project = matchingProjects.first,
          let projectID = project["id"] as? String else {
        throw CLIError.targetNotFound("Project '\(projectInput)' is ambiguous. Use its UUID or repository path.")
    }
    guard let suites = project["suites"] as? [[String: Any]] else {
        throw CLIError.protocolFailure("The app returned no suite catalog for project \(projectID).")
    }
    let matchingSuites = suites.filter {
        ($0["id"] as? String)?.caseInsensitiveCompare(suiteInput) == .orderedSame
            || ($0["name"] as? String)?.caseInsensitiveCompare(suiteInput) == .orderedSame
    }
    guard !matchingSuites.isEmpty else {
        throw CLIError.targetNotFound("No suite in \(project["name"] as? String ?? projectID) matches '\(suiteInput)'.")
    }
    guard matchingSuites.count == 1, let suiteID = matchingSuites.first?["id"] as? String else {
        throw CLIError.targetNotFound("Suite '\(suiteInput)' is ambiguous in \(project["name"] as? String ?? projectID). Use its UUID.")
    }
    return (projectID, suiteID)
}

func runCheck(_ options: Options) throws -> Int32 {
    let client = try MCPClient(endpoint: options.endpoint, credentialFile: options.credentialFile)
    try client.initialize()
    let catalog = try client.call(tool: "eval_list_projects", arguments: [:])
    let (projectID, suiteID) = try resolveTargets(catalog, projectInput: options.project, suiteInput: options.suite)
    let check = try client.call(tool: "eval_check", arguments: [
        "projectID": projectID,
        "suiteID": suiteID,
        "runID": options.runID.uuidString
    ])
    if let revision = check["revision"] as? String {
        print("Started \(options.runID.uuidString) for suite revision \(revision).")
    }

    let deadline = Date().addingTimeInterval(options.timeout)
    var lastProgress = ""
    while Date() < deadline {
        let payload = try client.call(tool: "eval_get_run", arguments: ["runID": options.runID.uuidString])
        guard let value = payload["run"] as? [String: Any], let phase = value["phase"] as? String else {
            throw CLIError.protocolFailure("The app returned no run phase.")
        }
        let completed = value["completedSamples"] as? Int ?? (value["results"] as? [Any])?.count ?? 0
        let planned = value["plannedSampleCount"] as? Int ?? completed
        let progress = "\(phase) \(completed)/\(planned)"
        if progress != lastProgress {
            FileHandle.standardError.write(Data((progress + "\n").utf8))
            lastProgress = progress
        }
        if !["running", "cancellation_requested"].contains(phase) {
            let release = try client.call(tool: "eval_release_report", arguments: [
                "projectID": projectID, "suiteID": suiteID, "runID": options.runID.uuidString
            ])
            if let markdown = release["markdown"] as? String { print(markdown) }
            let report = release["report"] as? [String: Any]
            return Int32(report?["outcome"] as? Int ?? 30)
        }
        Thread.sleep(forTimeInterval: 0.5)
    }
    throw CLIError.transport("Timed out waiting for run \(options.runID.uuidString). The run continues in the app.")
}

func runScenarioReport(_ options: ScenarioReportOptions) throws -> Int32 {
    let client = try MCPClient(endpoint: options.endpoint, credentialFile: options.credentialFile)
    try client.initialize()
    if options.stableExecution {
        let report = try client.call(tool: "eval_get_scenario_execution_report", arguments: ["executionID": options.runID.uuidString])
        guard let qualification = report["qualification"] as? [String: Any],
              let incomplete = qualification["incompleteEvidence"] as? [String],
              let failures = qualification["requiredFailures"] as? [String] else {
            throw CLIError.protocolFailure("The app returned no saved execution qualification.")
        }
        let data = try JSONSerialization.data(withJSONObject: report, options: [.prettyPrinted, .sortedKeys])
        print(String(decoding: data, as: UTF8.self))
        let release = qualification["report"] as? [String: Any]
        return !incomplete.isEmpty ? 20 : !failures.isEmpty ? 10 : release?["outcome"] as? String == "passed" ? 0 : 20
    }
    let report = try client.call(tool: "eval_get_scenario_report", arguments: [
        "runID": options.runID.uuidString
    ])
    guard let releaseCheck = report["releaseCheck"] as? [String: Any] else {
        throw CLIError.protocolFailure("The app returned no release check for scenario run \(options.runID.uuidString).")
    }
    guard let outcome = releaseCheck["outcome"] as? String,
          let summary = releaseCheck["summary"] as? String,
          let failures = releaseCheck["failures"] as? [String] else {
        throw CLIError.protocolFailure("The app returned an incomplete scenario release check.")
    }

    print("Intent Lab scenario run \(options.runID.uuidString): \(outcome)")
    print(summary)
    if failures.isEmpty {
        print("Failures: none")
    } else {
        print("Failures:")
        failures.forEach { print("- \($0)") }
    }
    return outcome == "passed" ? 0 : 30
}

func run() throws -> Int32 {
    let arguments = Array(CommandLine.arguments.dropFirst())
    guard let command = arguments.first else { throw CLIError.usage(Options.help) }
    switch command {
    case "check":
        if arguments.dropFirst().elementsEqual(["--help"]) || arguments.dropFirst().elementsEqual(["-h"]) {
            print(Options.help)
            return 0
        }
        return try runCheck(Options(arguments: arguments))
    case "scenario-report", "scenario-execution-report":
        if arguments.dropFirst().elementsEqual(["--help"]) || arguments.dropFirst().elementsEqual(["-h"]) {
            print(Options.help)
            return 0
        }
        return try runScenarioReport(ScenarioReportOptions(arguments: arguments))
    case "--help", "-h":
        print(Options.help)
        return 0
    default:
        throw CLIError.usage(Options.help)
    }
}

do {
    exit(try run())
} catch {
    FileHandle.standardError.write(Data(("foundation-evals: \(error.localizedDescription)\n").utf8))
    exit(30)
}
