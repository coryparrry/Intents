#!/bin/sh
set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
destination=${1:-"$repository_root/dist/intents-evidence-macos"}
scratch=${INTENTS_EVIDENCE_BUILD_SCRATCH:-"/tmp/intents-evidence-package-build"}

mkdir -p "$destination"
swift build --package-path "$repository_root" --scratch-path "$scratch" \
  --configuration release --jobs 2 --product intents-evidence
binary_directory=$(swift build --package-path "$repository_root" --scratch-path "$scratch" \
  --configuration release --show-bin-path)
cp "$binary_directory/intents-evidence" "$destination/intents-evidence"
chmod 755 "$destination/intents-evidence"

source_revision=$(git -C "$repository_root" rev-parse HEAD)
if [ -n "$(git -C "$repository_root" status --porcelain)" ]; then
  source_dirty=true
else
  source_dirty=false
fi
architecture=$(uname -m)
swift_version=$(swift --version | head -n 1)

/usr/bin/python3 - "$destination/intents-evidence" "$destination/manifest.json" \
  "$source_revision" "$source_dirty" "$architecture" "$swift_version" <<'PY'
import datetime
import hashlib
import json
import pathlib
import sys

binary = pathlib.Path(sys.argv[1])
manifest = pathlib.Path(sys.argv[2])
payload = {
    "schemaVersion": 1,
    "product": "intents-evidence",
    "policyID": "intent-lab-report-v3",
    "platform": "macOS",
    "architecture": sys.argv[5],
    "sourceRevision": sys.argv[3],
    "sourceTreeDirty": sys.argv[4] == "true",
    "swiftVersion": sys.argv[6],
    "binarySHA256": hashlib.sha256(binary.read_bytes()).hexdigest(),
    "builtAt": datetime.datetime.now(datetime.timezone.utc).isoformat(),
}
manifest.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
PY

tar -czf "$destination/intents-evidence-macos.tar.gz" -C "$destination" \
  intents-evidence manifest.json
shasum -a 256 "$destination/intents-evidence-macos.tar.gz" > \
  "$destination/intents-evidence-macos.tar.gz.sha256"
printf 'Packaged %s\n' "$destination/intents-evidence-macos.tar.gz"
