{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./ui/react/*"] },
    "noEmit": true
  },
  "include": ["ui/react/**/*"]
}
