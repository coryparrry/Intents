.DS_Store
.build/
__pycache__/
dist/

# Keep only the published repository artwork.
/.github/assets/*
!/.github/assets/readme-banner.png
!/.github/assets/foundation-evals-demo.gif
!/.github/assets/social-preview.jpg
FoundationEvals/FoundationEvals.xcodeproj/xcuserdata/
FoundationEvals/FoundationEvals.xcodeproj/project.xcworkspace/xcuserdata/

# Generated by script/ci_core_scheme.py in CI; do not commit.
FoundationEvals/FoundationEvals.xcodeproj/xcshareddata/xcschemes/FoundationEvalsCoreCI.xcscheme

# Keep only the public guides and CI/release instructions.
/docs/*
!/docs/ci.md
!/docs/DOCSTRING_COVERAGE.md
!/docs/ci-manual-tests.md
!/docs/EVAL_REVIEW_GUIDE.md
!/docs/MCP_CONTROL_GUIDE.md
!/docs/DEVELOPER_SWIFT_INTEGRATION.md
!/docs/FEATURE_ADAPTER.md
!/docs/PRODUCTION_EVALS_GUIDE.md
!/docs/PROMPT_IMPROVEMENT_PLAN.md
!/docs/coreai-provider.md
!/docs/custom-provider-protocol.md
!/docs/foundation-model-features.md
!/docs/releasing.md
!/docs/telemetry.md
!/docs/workflow-traces.md
!/docs/wiki/
!/docs/wiki/*.md

# Local signing material.
*.p12
*.p8
*.mobileprovision
*.provisionprofile

# Local audit reports, build logs, screenshots, and working notes.
/worklog.md
/website/QA.md
/website/WORKLOG.md
/.codegraph/
/Verification/**
/plugins/apple-foundation-evals/WORKLOG.md
/plugins/apple-foundation-evals/native/WORKLOG.md

# Keep executable verification inputs, developer hosts, and formal models.
!/Verification/Automation/
!/Verification/Automation/Fixtures/
!/Verification/Automation/Fixtures/**

# Historical captures with no runtime, build, or test consumer.
/Verification/Automation/Fixtures/CodecMetadata/QualifiedDeclarations.swift.txt
/Verification/Automation/Fixtures/CodecMetadata/product-manifest.json
/Verification/Automation/Fixtures/CodecMetadata/provenance.json
/Verification/Automation/Fixtures/CollectionMetadata/QualifiedDeclarations.swift.txt
/Verification/Automation/Fixtures/CollectionMetadata/RejectedNestedInputDeclarations.swift.txt
/Verification/Automation/Fixtures/CollectionMetadata/RejectedNestedResultDeclaration.swift.txt
/Verification/Automation/Fixtures/CollectionMetadata/provenance.json
/Verification/Automation/Fixtures/CollectionMetadata/unsupported-nested-inputs.json
/Verification/Automation/Fixtures/CollectionMetadata/unsupported-nested-result.json
/Verification/Automation/Fixtures/RuntimeCodecEcho/echo-actions.swift.txt
/Verification/Automation/Fixtures/RuntimeCodecEcho/scalar-actions.swift.txt
/Verification/Automation/Fixtures/Xcode272Metadata/QualifiedDeclarations.swift.txt
/Verification/Automation/Fixtures/Xcode272Metadata/project.pbxproj
/Verification/Automation/Fixtures/Xcode272Metadata/provenance.json
/Verification/Automation/Fixtures/DuplicateTasks/Metadata/provenance.json
/Verification/Automation/Fixtures/IntentFileDeclarations/xcresult-export-attachments-schema.json

# Local rewrite verification artifacts and caches.
/.validation/
