.DS_Store
.build/
__pycache__/
dist/

# Keep only the published repository artwork.
/.github/assets/*
!/.github/assets/readme-banner.png
!/.github/assets/foundation-evals-demo.gif
!/.github/assets/social-preview.jpg
FoundationEvals/FoundationEvals.xcodeproj/xcuserdata/
FoundationEvals/FoundationEvals.xcodeproj/project.xcworkspace/xcuserdata/

# Generated by script/ci_core_scheme.py in CI; do not commit.
FoundationEvals/FoundationEvals.xcodeproj/xcshareddata/xcschemes/FoundationEvalsCoreCI.xcscheme

# Keep only the public guides and release instructions.
/docs/*
!/docs/EVAL_REVIEW_SPEC.md
!/docs/EVAL_REVIEW_GUIDE.md
!/docs/MCP_CONTROL_GUIDE.md
!/docs/DEVELOPER_SWIFT_INTEGRATION.md
!/docs/FEATURE_ADAPTER.md
!/docs/PRODUCTION_EVALS_SPEC.md
!/docs/PRODUCTION_EVALS_GUIDE.md
!/docs/MCP_CONTROL_SPEC.md
!/docs/coreai-provider.md
!/docs/custom-provider-protocol.md
!/docs/foundation-model-features.md
!/docs/releasing.md
!/docs/telemetry.md
!/docs/workflow-traces.md
!/docs/wiki/
!/docs/wiki/*.md

# Local signing material.
*.p12
*.p8
*.mobileprovision
*.provisionprofile

# Local audit reports, build logs, screenshots, and working notes.
/worklog.md
/.codegraph/
/Verification/**

# Keep executable verification inputs, developer hosts, and formal models.
!/Verification/Automation/
!/Verification/Automation/Fixtures/
!/Verification/Automation/Fixtures/**
!/Verification/DeveloperRunnerTestHost/
!/Verification/DeveloperRunnerTestHost/**
!/Verification/*.lean
!/Verification/Lean*.md
!/Verification/lean-toolchain
